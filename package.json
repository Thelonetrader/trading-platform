{
  "name": "trading-platform",
  "version": "0.2.0",
  "private": true,
  "homepage": ".",
  "main": "electron.js",
  "dependencies": {
    "@stoqey/ib": "^1.6.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "concurrently": "^10.0.4",
    "electron-store": "^11.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-scripts": "5.0.1",
    "wait-on": "^9.1.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:prod": "npm run build && ELECTRON_DEV=0 electron .",
    "dist": "npm run build && electron-builder --mac",
    "dist:dir": "npm run build && electron-builder --mac dir"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "extends": null,
    "appId": "com.thelonetrader.trading-platform",
    "productName": "Trading Platform",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "extraMetadata": {
      "main": "electron.js"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "electron.js",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
